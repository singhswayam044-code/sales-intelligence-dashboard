{
  "datasets": [
    {
      "name": "default",
      "displayName": "Total Orders",
      "queryLines": [
        "SELECT\n",
        "  total_orders\n",
        "FROM\n",
        "  dev_catalog.olist_gold.monthly_revenue\n",
        "WHERE\n",
        "  month\n",
        "    = (\n",
        "      SELECT\n",
        "        MAX(month)\n",
        "      FROM\n",
        "        dev_catalog.olist_gold.monthly_revenue\n",
        "    )"
      ]
    },
    {
      "name": "gross_revenue",
      "displayName": "delivered-only revenue",
      "queryLines": [
        "SELECT\n",
        "  ROUND(SUM(CASE WHEN order_status = 'delivered' THEN gross_revenue ELSE 0 END), 2) AS delivered_revenue,\n",
        "  ROUND(SUM(gross_revenue), 2) AS total_revenue\n",
        "FROM dev_catalog.olist_gold.monthly_revenue\n",
        "WHERE month = DATE_TRUNC('month', (SELECT MAX(month) FROM dev_catalog.olist_gold.monthly_revenue));"
      ]
    },
    {
      "name": "8df38b69",
      "displayName": "Average Delivery Days Calculation",
      "queryLines": [
        "SELECT ROUND(AVG(avg_delivery_days), 1) AS avg_delivery_days\r\n",
        "FROM dev_catalog.olist_gold.monthly_revenue;"
      ]
    },
    {
      "name": "6b1a5985",
      "displayName": "Average Monthly Review Score Analysis",
      "queryLines": [
        "SELECT ROUND(AVG(avg_review_score), 2) AS avg_review_score\r\n",
        "FROM dev_catalog.olist_gold.monthly_revenue;"
      ]
    },
    {
      "name": "44cd7055",
      "displayName": "Monthly Revenue Insights",
      "queryLines": [
        "SELECT\r\n",
        "  month,\r\n",
        "  gross_revenue,\r\n",
        "  total_orders,\r\n",
        "  avg_review_score\r\n",
        "FROM dev_catalog.olist_gold.monthly_revenue\r\n",
        "ORDER BY month;"
      ]
    },
    {
      "name": "842f0428",
      "displayName": "Customer Insights Summary Report",
      "queryLines": [
        "SELECT\r\n",
        "  segment,\r\n",
        "  COUNT(*) AS customer_count,\r\n",
        "  ROUND(AVG(monetary_value), 2) AS avg_spend,\r\n",
        "  ROUND(AVG(frequency), 1) AS avg_orders\r\n",
        "FROM dev_catalog.olist_gold.customer_rfm\r\n",
        "GROUP BY segment\r\n",
        "ORDER BY customer_count DESC;"
      ]
    },
    {
      "name": "bc56291e",
      "displayName": "Top Performing Sellers by Revenue and Ratings",
      "queryLines": [
        "SELECT\r\n",
        "  seller_id,\r\n",
        "  seller_state,\r\n",
        "  total_orders,\r\n",
        "  total_revenue,\r\n",
        "  avg_rating,\r\n",
        "  avg_delivery_days,\r\n",
        "  seller_tier\r\n",
        "FROM dev_catalog.olist_gold.seller_performance\r\n",
        "ORDER BY total_revenue DESC\r\n",
        "LIMIT 20;"
      ]
    },
    {
      "name": "bb4d17f9",
      "displayName": "Top Product Categories by Delivered Orders and Revenue",
      "queryLines": [
        "SELECT\r\n",
        "  category_name,\r\n",
        "  COUNT(DISTINCT order_id) AS total_orders,\r\n",
        "  ROUND(SUM(payment_value), 2) AS total_revenue,\r\n",
        "  ROUND(AVG(review_score), 2) AS avg_review_score\r\n",
        "FROM dev_catalog.olist_silver.orders_enriched\r\n",
        "WHERE order_status = 'delivered'\r\n",
        "  AND category_name != 'uncategorized'\r\n",
        "GROUP BY category_name\r\n",
        "ORDER BY total_revenue DESC\r\n",
        "LIMIT 15;"
      ]
    },
    {
      "name": "41788e00",
      "displayName": "Gross Revenue",
      "queryLines": [
        "SELECT\r\n",
        "  CONCAT('R$ ', FORMAT_NUMBER(SUM(gross_revenue), 2)) AS gross_revenue\r\n",
        "FROM dev_catalog.olist_gold.monthly_revenue\r\n",
        "WHERE month = DATE_TRUNC('month', (\r\n",
        "  SELECT MAX(month) FROM dev_catalog.olist_gold.monthly_revenue\r\n",
        "));"
      ]
    }
  ],
